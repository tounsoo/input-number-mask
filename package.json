{
  "name": "@tounsoo/input-number-mask",
  "version": "1.3.0",
  "description": "React component and hooks for masking number input: phone numbers, dates, credit cards and more. No dependencies besides React.",
  "packageManager": "pnpm@10.23.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.config.lib.ts && rollup -c rollup.config.dts.mjs",
    "check:package": "publint --strict && attw --pack . && node scripts/check-exports.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.config.ci.ts",
    "test:coverage": "vitest run --config vitest.coverage.ts --coverage",
    "prepublishOnly": "pnpm build:lib && pnpm check:package",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:lib && changeset publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^16.5.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^28.1.0",
    "marked": "^9.1.6",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.0",
    "rollup-plugin-dts": "^6.5.1",
    "storybook": "^10.6.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "react",
    "hook",
    "input",
    "mask",
    "phone",
    "date",
    "credit-card",
    "formatting",
    "form"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tounsoo/input-number-mask.git"
  },
  "bugs": {
    "url": "https://github.com/tounsoo/input-number-mask/issues"
  },
  "homepage": "https://github.com/tounsoo/input-number-mask#readme",
  "author": "tounsoo",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}